{
  "id": "chordism",
  "name": "Chordism",
  "abbrev": "CH",
  "version": "0.0.13",
  "description": "Chord-based polyphonic synthesizer with morphing mixer (DVNA-inspired)",
  "author": "charlesvestal",
  "license": "MIT",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": true,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Chordism",
          "params": [
            {
              "key": "chord_type",
              "label": "Chord",
              "type": "int",
              "min": 0,
              "max": 15,
              "default": 6,
              "step": 1,
              "options": ["Octaves", "Fifth", "Minor", "Min 7", "Min 9", "Min 11", "Major", "Maj 7", "Maj 9", "Sus 4", "6/9", "Min 6", "10th", "Dom 7", "Dom 7 b9", "Half Dim"]
            },
            {
              "key": "detune",
              "label": "Detune",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "filter_cutoff",
              "label": "Cutoff",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 1.0,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "filter_resonance",
              "label": "Reso",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "filter_mode",
              "label": "Filter",
              "type": "int",
              "min": 0,
              "max": 2,
              "default": 0,
              "step": 1,
              "options": ["LP", "HP", "BP"]
            },
            {
              "key": "filter_env_attack",
              "label": "FEnv A",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "filter_env_decay",
              "label": "FEnv D",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.30,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "filter_env_depth",
              "label": "FEnv Amt",
              "type": "float",
              "min": -1.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.02,
              "unit": "%"
            },
            {
              "key": "drive",
              "label": "Drive",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "volume",
              "label": "Volume",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.8,
              "step": 0.02,
              "unit": "%"
            },
            {
              "key": "waveform",
              "label": "Wave",
              "type": "int",
              "min": 0,
              "max": 3,
              "default": 0,
              "step": 1,
              "options": ["Sine", "Triangle", "Saw", "Square"]
            },
            {
              "key": "shape",
              "label": "Shape",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "lfo_shape",
              "label": "LFO Wave",
              "type": "int",
              "min": 0,
              "max": 3,
              "default": 0,
              "step": 1,
              "options": ["Triangle", "Ramp Up", "Ramp Down", "Square"]
            },
            {
              "key": "lfo_rate",
              "label": "LFO Rate",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "lfo_depth",
              "label": "LFO Depth",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "attack",
              "label": "Attack",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.05,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "release",
              "label": "Release",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.30,
              "step": 0.01,
              "unit": "%"
            }
          ],
          "knobs": ["chord_type", "detune", "filter_cutoff", "filter_resonance", "drive", "waveform", "shape", "lfo_rate"]
        }
      }
    }
  }
}
