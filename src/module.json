{
  "id": "chordism",
  "name": "Chordism",
  "abbrev": "CH",
  "version": "0.0.4",
  "description": "Chord-based polyphonic synthesizer with morphing mixer (DVNA-inspired)",
  "author": "charlesvestal",
  "license": "MIT",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": true,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Chordism",
          "params": [
            {
              "key": "volume",
              "label": "Volume",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.8,
              "step": 0.02,
              "unit": "%"
            },
            {
              "key": "waveform",
              "label": "Wave",
              "type": "int",
              "min": 0,
              "max": 3,
              "default": 0,
              "step": 1,
              "options": ["Sine", "Triangle", "Saw", "Square"]
            },
            {
              "key": "attack",
              "label": "Attack",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.05,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "release",
              "label": "Release",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.30,
              "step": 0.01,
              "unit": "%"
            }
          ],
          "knobs": ["volume", "waveform", "attack", "release"]
        }
      }
    }
  }
}
